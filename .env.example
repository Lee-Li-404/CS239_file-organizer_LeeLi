LLM_PROVIDER=openai
# Local pacing for NVIDIA and Ark only; OpenAI has no artificial RPM cap.
LLM_MAX_RPM=40
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_MAX_TOKENS=4000
# Bolt only: enable for larger analysis/planning tasks.
NVIDIA_ENABLE_THINKING=false

# Default provider. Set LLM_PROVIDER=nvidia to use NVIDIA instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_COMPLETION_TOKENS=8000

# Doubao / Volcengine Ark. Set LLM_PROVIDER=doubao after filling the local key.
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-lite-260915
ARK_MAX_COMPLETION_TOKENS=8000
